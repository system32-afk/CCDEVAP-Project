<link rel="stylesheet" href="CSS/login.css">

<div id="login-form" class="container mt-5">
    <div class="row justify-content-center">
        <form>
            <img src="images/Trippings-UI.png" />
            <h3 class="text-center mb-4">Account Login</h3>

            <div class="mb-3">
                <label for="email-field" class="form-label">Email Address</label>
                <input type="email" id="email-field" data-field="emailAddress" class="form-control py-2" value=""
                    required>

                <div class="mb-4">
                    <label for="password-field" class="form-label">Password</label>
                    <input type="text" id="password-field" name="password" class="form-control py-2" required>
                </div>
                <p>Don't have an account yet?
                    <a href="/register" class="btn btn-link p-0 pb-1 alignment-baseline">Register now!</a>
                </p>
                <button type="submit" class="btn btn-primary w-100 py-2">Login</button>
        </form>

    </div>
</div>
</div>