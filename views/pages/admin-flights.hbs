
   
    <link rel="stylesheet" href="/CSS/reservations.css" media="all">
    <link rel="stylesheet" href="/CSS/admin.css" media="all">


    <div id="navbar"></div>

    <div class="container-fluid content-section">
        <div class="row">
            <aside class="admin-sidebar">
                <ul class="nav flex-column admin-sidebar-nav gap-1">
                    <li class="nav-item">
                        <a href="admin-dashboard" class="nav-link rounded">
                            <img src="/images/dashboard-icon.png">
                            Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="admin-flights" class="nav-link active rounded">
                            <img src="/images/flight-management-icon.png">
                            Flight Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="admin-users" class="nav-link rounded">
                            <img src="/images/user-management-icon.png">
                            User Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="admin-reservations" class="nav-link rounded">
                            <img src="/images/reservation-management-icon.png">
                            Reservations Management
                        </a>
                    </li>
                </ul>
            </aside>
{{!-- dont remove above --}}
        <main class="admin-content">
            <h1 class="admin-title"><strong>FLIGHT MANAGEMENT</strong></h1>
            {{!-- sort  --}}
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
  
                        <label class="fw-bold mb-0">Sort By:</label>
                        <select id="cabinSelect" class="form-select form-select-sm" style="width: auto;" onchange="applyFilter()">
                            <option value="economy" {{#if (eq currentCabin 'economy')}}selected{{/if}}>Economy</option>
                            <option value="premium_economy" {{#if (eq currentCabin 'premium_economy')}}selected{{/if}}>Premium Economy</option>
                            <option value="business_class" {{#if (eq currentCabin 'business_class')}}selected{{/if}}>Business Class</option>
                            <option value="first_class" {{#if (eq currentCabin 'first_class')}}selected{{/if}}>First Class</option>
                        </select>
                </div>
            {{!-- sort  --}}
                
            {{!-- create flight button --}}
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-white btn-outline-dark" 
                            data-bs-toggle="modal" data-bs-target="#modal-create-flight">
                            Create Flight
                    </button>
                </div>
            </div>
            </div>
            {{!-- create flight button --}}

            <div class="analytics-table-card">
                <div class="table-responsive">
                    <table class="table table-hover admin-table">
                        <thead> {{!-- header --}}
                            <tr>
                                <th scope="col">Flight Number</th>
                                <th scope="col">Airline</th>
                                <th scope="col">Origin</th>
                                <th scope="col">Destination</th>
                                <th scope="col">Departure Date</th>
                                <th scope="col">Departure Time</th>
                                <th scope="col">Cabin</th>
                                <th scope="col">Fare (Price)</th>
                                <th scope="col">Seats</th>
                                <th scope="col" class="text-center"></th>
                                <th scope="col" class="text-center"></th>
                                <th scope="col" class="text-center"></th>
                            </tr>
                        </thead> {{!-- header --}}
                        
                        <tbody>
                            {{#each flights}}
                            <tr>
                                <td class="table-code-highlight">{{this.flightNumber}}</td>
                                <td>{{this.airline}}</td>
                                <td>{{this.origin}}</td>
                                <td>{{this.destination}}</td>
                                <td>{{formatDate this.departureDate}}</td>
                                <td class="table-code-highlight">{{this.departureTime}}</td>

                                    {{#if (eq ../currentCabin 'economy')}}
                                        <td>{{this.cabin.economy.label}}</td>
                                        <td>{{this.cabin.economy.price}}</td>
                                        <td>{{this.cabin.economy.seats}}</td>                                    
                                    {{/if}}
                                    {{#if (eq ../currentCabin 'premium_economy')}}
                                        <td>{{this.cabin.premium_economy.label}}</td>
                                        <td>{{this.cabin.premium_economy.price}}</td>
                                        <td>{{this.cabin.premium_economy.seats}}</td>                                    
                                    {{/if}}
                                    {{#if (eq ../currentCabin 'business_class')}}
                                        <td>{{this.cabin.business_class.label}}</td>
                                        <td>{{this.cabin.business_class.price}}</td>
                                        <td>{{this.cabin.business_class.seats}}</td>                                    
                                    {{/if}}
                                    {{#if (eq ../currentCabin 'first_class')}}
                                        <td>{{this.cabin.first_class.label}}</td>
                                        <td>{{this.cabin.first_class.price}}</td>
                                        <td>{{this.cabin.first_class.seats}}</td>                                    
                                    {{/if}}
                                <td><button class="edit-button table-btn"  data-bs-toggle="modal" data-bs-target="#modal-update-flight" onclick="openUpdateModal({{this.flightNumber}})">Edit</button></td>
                                <td><button class="cancel-button table-btn" onclick="openCancelModal({{this.flightNumber}})">Cancel</button></td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>



            <!-- Modals-->



            <!-- Cancellation of Reservation Modal -->
            <div id="modal-cancel-flight" class="modal-overlay" tabindex="-1">
                <div class="modal-content-box-small">
                    <h2 class="modal-title text-danger">CANCELLATION OF FLIGHT</h2>
                    <p>Proceed with cancelling this flight?</p>
                    <div class="options-group">
                        <button class="cancellation-modal-yes-btn" onclick="confirmDeactivate()">Yes, Cancel Flight</button>
                        <button class="cancellation-modal-no-btn" onclick="closeModal('modal-cancel-flight')">No, Keep Flight</button>
                    </div>
                </div>
            </div>
            <!-- Cancellation of Reservation Modal -->

            <!-- Save Changes Modal -->
            <div id="modal-edit-save" class="modal-overlay">
                <div class="modal-content-box-small">
                    <h2>SAVE CHANGES</h3>
                    <p>
                        Proceed with updated changes?
                    </p>

                    <div class="options-group">
                        <button class="cancellation-modal-yes-btn" onclick="closeModal('modal-edit-save')">Yes, Save</button>
                        <button class="cancellation-modal-no-btn" onclick="closeModal('modal-edit-save')">No, Keep Editing</button>
                    </div>
                </div>
            </div>
            {{!-- update flight modal --}}
            <div id="modal-update-flight" class="modal fade" data-bs-backdrop="static"data-bs-keyboard="false" tabindex="-1">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-primary fw-bold">Update Flight</h5>
                    </div>
                    <div class="modal-body">
                        <form action="/admin-flights" method="POST" id="editFlightForm">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="flightNumber" class="form-label">Flight Number:</label>
                                        <input type="number" class="form-control" name="flightNumber" id="update-flightNumber-field" value="{{flight.flightNumber}}" min="0"  required >
                                </div>
                                <div class="col-md-6">
                                    <label for="airline" class="form-label">Airline:</label>
                                        <select name="airline" class="form-control" id="update-airline-field" required>
                                            {{#each airlines}}
                                                    <option value="{{airlineName}}">{{airlineName}}</option>
                                                {{/each}}
                                        </select>
                                </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="origin" class="form-label">Origin:</label>
                                        <select name="origin" id="update-origin-field" class="form-control" required>
                                            {{#each cities}}
                                                <option value="{{this.cityName}}">{{cityName}}</option>
                                            {{/each}}
                                        </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="destination" class="form-label">Destination:</label>
                                        <select name="origin" id="update-destination-field" class="form-control" required>
                                            {{#each cities}}
                                                <option value="{{this.cityName}}">{{cityName}}</option>
                                            {{/each}}
                                        </select>                                
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="logoName">Logo Code:</label>
                                        <input type="text" class="form-control" name="logoName" id="update-logoName-field" value="{{flight.logoName}}"  required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="numOfLayovers">Layovers:</label>
                                        <input type="number" class="form-control" name="numOfLayovers" id="update-numOfLayovers-field" value="{{flight.numOfLayovers}}"  required>
                                </div>
                                
                                <div class="col-md-4">
                                    <label class="form-label" for="isActive">Status:</label>
                                        <select class="form-control" name="isActive" id="update-isActive-field" value="{{flight.isActive}}" required>
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </select>
                                </div>

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label  class="form-label" for="departureDate">Departure Date:</label>
                                        <input type="date" class="form-control" name="departureDate" id="update-departureDate-field" value="{{flight.departureDate}}"  required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="departureTime">Departure Time:</label>
                                        <input type="time" class="form-control" name="departureTime" id="update-departureTime-field" value="{{flight.departureTime}}" required>
                                </div>

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="arrivalDate">Arrival Date:</label>
                                        <input type="date" class="form-control" name="arrivalDate" id="update-arrivalDate-field" value="{{flight.arrivalDate}}"  required>
                                </div>
                                <div class="col-md-6">
                                    <label for="arrivalTime" class="form=label">Arrival Time:</label>
                                        <input type="time" class="form-control" name="arrivalTime" id="update-arrivalTime-field" value="{{flight.arrivalTime}}"  required>
                                </div>

                            </div>
                            <hr>
                            <h5 class="mb-3 text-primary fw-bold">Cabin Classes:</h5>
                            {{!-- ECONOMY --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Economy:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="economy_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="update-economy_price-field" name="cabin[economy][price]"
                                                value="{{flight.cabin.economy.price}}" min="0"   required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="economy_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="update-economy_seats-field" name="cabin[economy][seats]"
                                                value="{{flight.cabin.economy.seats}}" min="0"   required>
                                        </div>                                     

                                </div>
                            {{!-- PREM ECONOMY --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Premium Economy:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="premium_economy_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="update-premium_economy_price-field" name="cabin[premium_economy][price]"
                                                value="{{flight.cabin.premium_economy.price}}" min="0"   required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="premium_economy_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="update-premium_economy_seats-field" name="cabin[premium_economy][seats]"
                                                value="{{flight.cabin.premium_economy.seats}}"  min="0"   required>
                                        </div>                                     

                                </div>
                            {{!-- BUSINESS CLASS --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Business Class:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="business_class_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="update-business_class_price-field" name="cabin[business_class][price]"
                                                value="{{flight.cabin.business_class.price}}"  min="0"   required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="business_class_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="update-business_class_seats-field" name="cabin[business_class][seats]"
                                                value="{{flight.cabin.business_class.seats}}"  min="0"   required>
                                        </div>                                     

                                </div>

                            {{!-- FIRST CLASS --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">First Class:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="first_class_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="update-first_class_price-field" name="cabin[first_class][price]"
                                                value="{{flight.cabin.first_class.price}}" min="0"   required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="first_class_price_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="update-first_class_seats-field" name="cabin[first_class][seats]"
                                                value="{{flight.cabin.first_class.seats}}"  min="0"   required>
                                        </div>                                     

                                </div>
                                    <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="button" onclick="updateFlightInformation()" id="saveFlightBtn" class="btn btn-primary">Update Flight</button>
                                </div>
                            </div>

                        </form>
                    </div>

                    </div>
                    </div>
                </div>
                {{!-- update flight modal --}}

            {{!-- create-flight modal --}}
            <div class="modal fade" id="modal-create-flight" data-bs-backdrop="static"data-bs-keyboard="false" tabindex="-1">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-primary fw-bold">Create Flight</h5>
                    </div>
                    <div class="modal-body">
                        <form action="/admin-flights" method="POST">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="flightNumber" class="form-label">Flight Number:</label>
                                        <input type="number" class="form-control" name="flightNumber" id="flightNumber-field" placeholder="6767" min="0">
                                </div>
                                <div class="col-md-6">
                                    <label for="airline" class="form-label">Airline:</label>
                                        <select name="airline" id="airline-field" class="form-control" required>

                                            <option value="">Select Airline</option>
                                                {{#each airlines}}
                                                    <option value="{{this.airlineName}}">{{this.airlineName}}</option>
                                                {{/each}}
                                        </select>
                                </div>
                                </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="origin" class="form-label">Origin:</label>
                                        <select name="origin" id="origin-field" class="form-control" required>

                                            <option value="">Select Origin</option>
                                                {{#each cities}}
                                                    <option value="{{this.cityName}}">{{this.cityName}}</option>

                                                {{/each}}
                                        </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="destination" class="form-label">Destination:</label>
                                        <select name="destination" id="destination-field" class="form-control" required>
                                            <option value="">Select Destination</option>
                                                {{#each cities}}
                                                    <option value="{{this.cityName}}">{{this.cityName}}</option>
                                                {{/each}}
                                        </select>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="logoName">Logo Code:</label>
                                        <input type="text" class="form-control" name="logoName" id="logoName-field" placeholder="PAL" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="numOfLayovers">Layovers:</label>
                                        <input type="number" class="form-control" name="numOfLayovers-field" id="numOfLayovers" placeholder="0" required>
                                </div>
                                
                                <div class="col-md-4">
                                    <label class="form-label" for="isActive">Status:</label>
                                        <select class="form-control" name="isActive-field" id="isActive" required>
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </select>
                                </div>

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label  class="form-label" for="departureDate">Departure Date:</label>
                                        <input type="date" class="form-control" name="departureDate" id="departureDate-field" placeholder="YYYY-MM-DD" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="departureTime">Departure Time:</label>
                                        <input type="time" class="form-control" name="departureTime" id="departureTime-field"required>
                                </div>

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="arrivalDate">Arrival Date:</label>
                                        <input type="date" class="form-control" name="arrivalDate" id="arrivalDate-field" placeholder="YYYY-MM-DD" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="arrivalTime" class="form=label">Arrival Time:</label>
                                        <input type="time" class="form-control" name="arrivalTime" id="arrivalTime-field"required>
                                </div>

                            </div>
                            <hr>
                            <h5 class="mb-3 text-primary fw-bold">Cabin Classes:</h5>
                            {{!-- ECONOMY --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Economy:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="economy_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="economy_price-field" name="cabin[economy][price]"
                                                placeholder="Price" min="0" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="economy_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="economy_seats-field" name="cabin[economy][seats]"
                                                placeholder="Seats" min="0" required>
                                        </div>                                     

                                </div>
                            {{!-- PREM ECONOMY --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Premium Economy:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="premium_economy_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="premium_economy_price-field" name="cabin[premium_economy][price]"
                                                placeholder="Price" min="0" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="premium_economy_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="premium_economy_seats-field" name="cabin[premium_economy][seats]"
                                                placeholder="Seats" min="0" required>
                                        </div>                                     

                                </div>
                            {{!-- BUSINESS CLASS --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Business Class:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="business_class_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="business_class_price-field" name="cabin[business_class][price]"
                                                placeholder="Price" min="0" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="business_class_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="business_class_seats-field" name="cabin[business_class][seats]"
