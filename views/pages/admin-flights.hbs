{{!-- dont remove above --}}
        <main class="admin-content">
            <h1 class="admin-title"><strong>FLIGHT MANAGEMENT</strong></h1>
            {{!-- sort  --}}
        <div class="d-flex justify-content-between align-items-center mb-3">

            <!-- Left -->
            <div class="d-flex align-items-center gap-3">
                <label class="fw-bold mb-0">Sort By:</label>

                <select id="cabinSelect"
                        class="form-select form-select-sm"
                        style="width: auto;"
                        onchange="applyFilter()">
                    <option value="economy" {{#if (eq currentCabin 'economy')}}selected{{/if}}>Economy</option>
                    <option value="premium_economy" {{#if (eq currentCabin 'premium_economy')}}selected{{/if}}>Premium Economy</option>
                    <option value="business_class" {{#if (eq currentCabin 'business_class')}}selected{{/if}}>Business Class</option>
                    <option value="first_class" {{#if (eq currentCabin 'first_class')}}selected{{/if}}>First Class</option>
                </select>
            </div>

            {{!-- Create Flight bUtton --}}
            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modal-create-flight">
                    Create Flight
                </button>
            {{!-- Create Flight bUtton --}}
            {{!-- Airline Button --}}
                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modal-airline">
                    Airlines
                </button>
                
                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modal-city">
                    Cities
                </button>
            {{!-- Airline Button --}}
            </div>

        </div>
            <div class="analytics-table-card">
                <div class="table-responsive">
                    <table class="table table-hover admin-table">
                        <thead> {{!-- header --}}
                            <tr>
                                <th scope="col">Flight Number</th>
                                <th scope="col">Airline</th>
                                <th scope="col">Origin</th>
                                <th scope="col">Destination</th>
                                <th scope="col">Departure Date</th>
                                <th scope="col">Departure Time</th>
                                <th scope="col">Cabin</th>
                                <th scope="col">Fare (Price)</th>
                                <th scope="col">Seats</th>
                                <th scope="col" class="text-center"></th>
                                <th scope="col" class="text-center"></th>
                                <th scope="col" class="text-center"></th>
                            </tr>
                        </thead> {{!-- header --}}
                        
                        <tbody>
                            {{#each flights}}
                            <tr id="flight-rows{{this._id}}">
                                <td class="flightNumber table-code-highlight">{{this.flightNumber}}</td>
                                <td class="airline">{{this.airline}}</td>
                                <td class="origin">{{this.origin}}</td>
                                <td class="destination">{{this.destination}}</td>
                                <td class="departureDate">{{formatDate this.departureDate}}</td>
                                <td class="departureTime table-code-highlight">{{this.departureTime}}</td>

                                <td class="cabin-label" 
                                data-economy="{{this.cabin.economy.label}}"
                                data-premium_economy="{{this.cabin.premium_economy.label}}"
                                data-business_class="{{this.cabin.business_class.label}}"
                                data-first_class="{{this.cabin.first_class.label}}">
                                {{this.cabin.economy.label}}
                                </td>

                                <td class="cabin-price" 
                                data-economy="{{this.cabin.economy.price}}"
                                data-premium_economy="{{this.cabin.premium_economy.price}}"
                                data-business_class="{{this.cabin.business_class.price}}"
                                data-first_class="{{this.cabin.first_class.price}}">
                                {{this.cabin.economy.price}}
                                </td>

                                <td class="cabin-seats" 
                                data-economy="{{this.cabin.economy.seats}}"
                                data-premium_economy="{{this.cabin.premium_economy.seats}}"
                                data-business_class="{{this.cabin.business_class.seats}}"
                                data-first_class="{{this.cabin.first_class.seats}}">
                                {{this.cabin.economy.seats}}
                                </td>

                                <td><button class="edit-button table-btn"  data-bs-toggle="modal" data-bs-target="#modal-update-flight" onclick="openUpdateModal('{{this._id}}')">Edit</button></td>
                                <td><button class="cancel-button table-btn" data-bs-toggle="modal" data-bs-target="#modal-cancel-flight"onclick="openCancelModal({{this._id}})">Cancel</button></td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>



            <!-- Modals-->



            <!-- Cancellation of Reservation Modal -->
            <div id="modal-cancel-flight" class="modal-overlay" tabindex="-1">
                <div class="modal-content-box-small">
                    <h2 class="modal-title text-danger">CANCELLATION OF FLIGHT</h2>
                    <p>Proceed with cancelling this flight?</p>
                    <div class="options-group">
                        <button class="cancellation-modal-yes-btn" onclick="confirmDeactivate()">Yes, Cancel Flight</button>
                        <button class="cancellation-modal-no-btn" onclick="closeModal('modal-cancel-flight')">No, Keep Flight</button>
                    </div>
                </div>
            </div>
            <!-- Cancellation of Reservation Modal -->

{{!-- Cities Modal --}}
<div class="modal fade" id="modal-city"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title text-primary fw-bold">
                    City Management
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-hover admin-table align-middle">
                        <thead>
                            <tr>
                                <th>City Name</th>
                                <th scope="col" class="text-center"></th>
                                <th scope="col" class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each cities }}
                            <tr id="city-row{{this._id}}">
                                <td class="city-name">{{this.cityName}}</td>
                                <td>
                                    <button class="edit-button table-btn"
                                            data-bs-toggle="modal" data-bs-target="#edit-city-modal" onclick="openUpdateCityModal('{{this._id}}')">
                                        Edit
                                    </button>
                                </td>

                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#create-city-modal">
                    Add City
                </button>
            </div>

        </div>
    </div>
</div>
{{!-- Airline Modal --}}
<div class="modal fade" id="modal-airline"data-bs-backdrop="static"data-bs-keyboard="false"tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title text-primary fw-bold">
                    Airline Management
                </h5>

                <button type="button"class="btn-close"data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="table-responsive">
                    <table class="table table-hover admin-table align-middle">

                        <thead>
                            <tr>
                                <th>Airline Name</th>
                                <th>Airline Status</th>
                                <th scope="col" class="text-center"></th>
                                <th scope="col" class="text-center"></th>
                            </tr>
                        </thead>

                        <tbody>

                            {{#each airlines}}
                                <tr id="airline-row{{this._id}}">
                                    <td class="airline-name">{{this.airlineName}}</td>
                                    <td class="airline-status">{{this.isAirlineActive}}</td>

                                    <td>
                                        <button
                                            class="edit-button table-btn" data-bs-toggle="modal" data-bs-target="#edit-airline-modal" onclick="openUpdateAirlineModal('{{this._id}}')">
                                            Edit
                                        </button>
                                    </td>

                                    <td>
                                        <button
                                            class="cancel-button table-btn" onclick="confirmDeactivateAirline('{{this._id}}')">
                                            Cancel
                                        </button>
                                    </td>
                                </tr>
                            {{/each}}

                        </tbody>

                    </table>
                </div>

            </div>

            <div class="modal-footer">

                <button
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#create-airline-modal">
                    Add Airline
                </button>

            </div>

        </div>
    </div>
</div>
