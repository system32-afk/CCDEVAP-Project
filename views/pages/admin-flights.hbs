{{!-- update flight modal --}}
            <div id="modal-update-flight" class="modal fade" data-bs-backdrop="static"data-bs-keyboard="false" tabindex="-1">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-primary fw-bold">Update Flight</h5>
                    </div>
                    <div class="modal-body">
                        <form action="/admin/admin-flights" method="POST" id="editFlightForm">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="flightNumber" class="form-label">Flight Number:</label>
                                        <input type="number" class="form-control" name="flightNumber" id="update-flightNumber-field" value="{{flight.flightNumber}}" min="0"  required >
                                </div>
                                <div class="col-md-6">
                                    <label for="airline" class="form-label">Airline:</label>
                                        <select name="airline" class="form-control" id="update-airline-field" required>
                                            {{#each airlines}}
                                                    <option value="{{this.airlineName}}">{{airlineName}}</option>
                                                {{/each}}
                                        </select>
                                </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="origin" class="form-label">Origin:</label>
                                        <select name="origin" id="update-origin-field" class="form-control" required>
                                            {{#each cities}}
                                                <option value="{{this.cityName}}">{{cityName}}</option>
                                            {{/each}}
                                        </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="destination" class="form-label">Destination:</label>
                                        <select name="destination" id="update-destination-field" class="form-control" required>
                                            {{#each cities}}
                                                <option value="{{this.cityName}}">{{cityName}}</option>
                                            {{/each}}
                                        </select>                                
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="logoName">Logo Code:</label>
                                        <input type="text" class="form-control" name="logoName" id="update-logoName-field" value="{{flight.logoName}}"  required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="numOfLayovers">Layovers:</label>
                                        <input type="number" class="form-control" name="numOfLayovers" id="update-numOfLayovers-field" value="{{flight.numOfLayovers}}"  required>
                                </div>
                                
                                <div class="col-md-4">
                                    <label class="form-label" for="isActive">Status:</label>
                                        <select class="form-control" name="isActive" id="update-isActive-field" value="{{flight.isActive}}" required>
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </select>
                                </div>

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label  class="form-label" for="departureDate">Departure Date:</label>
                                        <input type="date" class="form-control" name="departureDate" id="update-departureDate-field" value="{{flight.departureDate}}"  required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="departureTime">Departure Time:</label>
                                        <input type="time" class="form-control" name="departureTime" id="update-departureTime-field" value="{{flight.departureTime}}" required>
                                </div>

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="arrivalDate">Arrival Date:</label>
                                        <input type="date" class="form-control" name="arrivalDate" id="update-arrivalDate-field" value="{{flight.arrivalDate}}"  required>
                                </div>
                                <div class="col-md-6">
                                    <label for="arrivalTime" class="form=label">Arrival Time:</label>
                                        <input type="time" class="form-control" name="arrivalTime" id="update-arrivalTime-field" value="{{flight.arrivalTime}}"  required>
                                </div>

                            </div>
                            <hr>
                            <h5 class="mb-3 text-primary fw-bold">Cabin Classes:</h5>
                            {{!-- ECONOMY --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Economy:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="economy_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="update-economy_price-field" name="cabin[economy][price]"
                                                value="{{flight.cabin.economy.price}}" min="0"   required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="economy_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="update-economy_seats-field" name="cabin[economy][seats]"
                                                value="{{flight.cabin.economy.seats}}" min="0" max="60"   required>
                                        </div>                                     

                                </div>
                            {{!-- PREM ECONOMY --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Premium Economy:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="premium_economy_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="update-premium_economy_price-field" name="cabin[premium_economy][price]"
                                                value="{{flight.cabin.premium_economy.price}}" min="0"   required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="premium_economy_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="update-premium_economy_seats-field" name="cabin[premium_economy][seats]"
                                                value="{{flight.cabin.premium_economy.seats}}"  min="0" max="60"  required>
                                        </div>                                     

                                </div>
                            {{!-- BUSINESS CLASS --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Business Class:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="business_class_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="update-business_class_price-field" name="cabin[business_class][price]"
                                                value="{{flight.cabin.business_class.price}}"  min="0"   required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="business_class_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="update-business_class_seats-field" name="cabin[business_class][seats]"
                                                value="{{flight.cabin.business_class.seats}}"  min="0" max="60"   required>
                                        </div>                                     

                                </div>

                            {{!-- FIRST CLASS --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">First Class:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="first_class_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="update-first_class_price-field" name="cabin[first_class][price]"
                                                value="{{flight.cabin.first_class.price}}" min="0"  required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="first_class_price_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="update-first_class_seats-field" name="cabin[first_class][seats]"
                                                value="{{flight.cabin.first_class.seats}}"  min="0" max="60"   required>
                                        </div>                                     

                                </div>
                                    <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="button" onclick="updateFlightInformation()" id="saveFlightBtn" class="btn btn-primary">Update Flight</button>
                                </div>
                            </div>

                        </form>
                    </div>

                    </div>
                    </div>
                </div>
