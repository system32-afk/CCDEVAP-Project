            {{!-- create-flight modal --}}
            <div class="modal fade" id="modal-create-flight" data-bs-backdrop="static"data-bs-keyboard="false" tabindex="-1">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-primary fw-bold">Create Flight</h5>
                    </div>
                    <div class="modal-body">
                        <form action="/admin/admin-flights" method="POST" onsubmit="return validateFlight()">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="flightNumber" class="form-label">Flight Number:</label>
                                        <input type="number" class="form-control" name="flightNumber" id="flightNumber-field" placeholder="6767" min="0">
                                </div>
                                <div class="col-md-6">
                                    <label for="airline" class="form-label">Airline:</label>
                                        <select name="airline" id="airline-field" class="form-control" required>

                                            <option value="">Select Airline</option>
                                                {{#each airlines}}
                                                    <option value="{{this.airlineName}}">{{this.airlineName}}</option>
                                                {{/each}}
                                        </select>
                                </div>
                                </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="origin" class="form-label">Origin:</label>
                                        <select name="origin" id="origin-field" class="form-control" required>

                                            <option value="">Select Origin</option>
                                                {{#each cities}}
                                                    <option value="{{this.cityName}}">{{this.cityName}}</option>

                                                {{/each}}
                                        </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="destination" class="form-label">Destination:</label>
                                        <select name="destination" id="destination-field" class="form-control" required>
                                            <option value="">Select Destination</option>
                                                {{#each cities}}
                                                    <option value="{{this.cityName}}">{{this.cityName}}</option>
                                                {{/each}}
                                        </select>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="logoName">Logo Code:</label>
                                        <input type="text" class="form-control" name="logoName" id="logoName-field" placeholder="PAL" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="numOfLayovers">Layovers:</label>
                                        <input type="number" class="form-control" name="numOfLayovers" id="numOfLayovers-field" placeholder="0" required>
                                </div>
                                
                                <div class="col-md-4">
                                    <label class="form-label" for="isActive">Status:</label>
                                        <select class="form-control" name="isActive" id="isActive-field" required>
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </select>
                                </div>

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label  class="form-label" for="departureDate">Departure Date:</label>
                                        <input type="date" class="form-control" name="departureDate" id="departureDate-field" placeholder="YYYY-MM-DD" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="departureTime">Departure Time:</label>
                                        <input type="time" class="form-control" name="departureTime" id="departureTime-field"required>
                                </div>

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="arrivalDate">Arrival Date:</label>
                                        <input type="date" class="form-control" name="arrivalDate" id="arrivalDate-field" placeholder="YYYY-MM-DD" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="arrivalTime" class="form=label">Arrival Time:</label>
                                        <input type="time" class="form-control" name="arrivalTime" id="arrivalTime-field"required>
                                </div>

                            </div>
                            <hr>
                            <h5 class="mb-3 text-primary fw-bold">Cabin Classes:</h5>
                            {{!-- ECONOMY --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Economy:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="economy_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="economy_price-field" name="cabin[economy][price]"
                                                placeholder="Price" min="0" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="economy_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="economy_seats-field" name="cabin[economy][seats]"
                                                placeholder="Seats" min="0" max="60" placeholder="60" required>
                                        </div>                                     

                                </div>
                            {{!-- PREM ECONOMY --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Premium Economy:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="premium_economy_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="premium_economy_price-field" name="cabin[premium_economy][price]"
                                                placeholder="Price" min="0" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="premium_economy_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="premium_economy_seats-field" name="cabin[premium_economy][seats]"
                                                placeholder="Seats" min="0" max="60" placeholder="60" required>
                                        </div>                                     

                                </div>
                            {{!-- BUSINESS CLASS --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">Business Class:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="business_class_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="business_class_price-field" name="cabin[business_class][price]"
                                                placeholder="Price" min="0" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="business_class_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="business_class_seats-field" name="cabin[business_class][seats]"
                                                placeholder="Seats" min="0" max="60" placeholder="60" required>
                                        </div>                                     

                                </div>

                            {{!-- FIRST CLASS --}}
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-4">
                                    
                                        <label class="form-label fw-bold">First Class:</label>
                                    </div>
                                        <div class="col-md-4">
                                            <label for="first_class_price" class="form-label">Price:</label>
                                                <input type="number" class="form-control" id="first_class_price-field" name="cabin[first_class][price]"
                                                placeholder="Price" min="0" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="first_class_price_seats" class="form-label">Seats:</label>
                                                <input type="number" class="form-control" id="first_class_seats-field" name="cabin[first_class][seats]"
                                                placeholder="Seats" min="0" max="60" placeholder="60" required>
                                        </div>                                     

                                </div>
                            </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="submit"id="saveFlightBtn" class="btn btn-primary">Create Flight</button>
                                </div>
                        </form>
                    </div>

                    </div>
                </div>
                {{!-- create flight modal --}}
            </div>
        </main>

    </div>
</div>

<script>
    $(document).ready(function() {
        $("#navbar").load("navigation", function() {
            $("#nav-home").addClass("active");
        });
    });

    
</script>