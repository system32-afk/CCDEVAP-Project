                                        </div>                                     

                                </div>
                            </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="submit"id="saveFlightBtn" class="btn btn-primary">Create Flight</button>
                                </div>
                        </form>
                    </div>

                    </div>
                </div>
                {{!-- create flight modal --}}
            </div>
        </main>

    </div>
</div>

