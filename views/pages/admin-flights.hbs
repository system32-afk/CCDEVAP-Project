   
    <link rel="stylesheet" href="/CSS/reservations.css" media="all">
    <link rel="stylesheet" href="/CSS/admin.css" media="all">


    <div id="navbar"></div>

    <div class="container-fluid content-section">
        <div class="row">
            <aside class="admin-sidebar">
                <ul class="nav flex-column admin-sidebar-nav gap-1">
                    <li class="nav-item">
                        <a href="admin-dashboard" class="nav-link rounded">
                            <img src="/images/dashboard-icon.png">
                            Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="admin-flights" class="nav-link active rounded">
                            <img src="/images/flight-management-icon.png">
                            Flight Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="admin-users" class="nav-link rounded">
                            <img src="/images/user-management-icon.png">
                            User Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="admin-reservations" class="nav-link rounded">
                            <img src="/images/reservation-management-icon.png">
                            Reservations Management
                        </a>
                    </li>
                </ul>
            </aside>
            
        <main class="admin-content">
            <h1 class="admin-title"><strong>FLIGHT MANAGEMENT</strong></h1>
                
            <div class="analytics-table-card">
                <div class="table-responsive">
                    <table class="table table-hover admin-table">
                        <thead>
                            <tr>
                                <th scope="col">Flight Number</th>
                                <th scope="col">Airline</th>
                                <th scope="col">Origin</th>
                                <th scope="col">Destination</th>
                                <th scope="col">Departure Time</th>
                                <th scope="col">Fare (Price)</th>
                                <th scope="col" class="text-center">Status</th>
                                <th scope="col" class="text-center"></th>
                                <th scope="col" class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="table-code-highlight">PR-1845</td>
                                <td>Philippine Airlines</td>
                                <td>NAIA (Manila)</td>
                                <td>MCIA (Cebu)</td>
                                <td class="table-code-highlight">08:30 AM</td>
                                <td>PHP 5,450</td>
                                <td class="text-center">
                                    <span class="status-badge confirmed">Available</span>
                                </td>
                                <td><button class="edit-button table-btn" onclick="openModal('modal-edit-flight')">Edit</button></td>
                                <td><button class="cancel-button table-btn" onclick="openModal('modal-cancel-flight')">Cancel</button></td>
                            </tr>

                            <tr>
                                <td class="table-code-highlight">5J-561</td>
                                <td>Cebu Pacific</td>
                                <td>CIA (Clark)</td>
                                <td>BIA (Albay)</td>
                                <td class="table-code-highlight">11:15 AM</td>
                                <td>PHP 3,200</td>
                                <td class="text-center">
                                    <span class="status-badge confirmed">Available</span>
                                </td>
                                <td><button class="edit-button table-btn" onclick="openModal('modal-edit-flight')">Edit</button></td>
                                <td><button class="cancel-button table-btn" onclick="openModal('modal-cancel-flight')">Cancel</button></td>
                            </tr>

                            <tr>
                                <td class="table-code-highlight">CX-6111</td>
                                <td>Cathay Pacific</td>
                                <td>NAIA (Manila)</td>
                                <td>SA (Siargao)</td>
                                <td class="table-code-highlight">01:45 PM</td>
                                <td>PHP 7,800</td>
                                <td class="text-center">
                                    <span class="status-badge pending">Delayed</span>
                                </td>
                                <td><button class="edit-button table-btn" onclick="openModal('modal-edit-flight')">Edit</button></td>
                                <td><button class="cancel-button table-btn" onclick="openModal('modal-cancel-flight')">Cancel</button></td>
                            </tr>

                            <tr>
                                <td class="table-code-highlight">Z2-2932</td>
                                <td>Air Asia</td>
                                <td>IIA (Iloilo)</td>
                                <td>NAIA (Manila)</td>
                                <td class="table-code-highlight">04:20 PM</td>
                                <td>PHP 4,150</td>
                                <td class="text-center">
                                    <span class="status-badge confirmed">Available</span>
                                </td>
                                <td><button class="edit-button table-btn" onclick="openModal('modal-edit-flight')">Edit</button></td>
                                <td><button class="cancel-button table-btn" onclick="openModal('modal-cancel-flight')">Cancel</button></td>
                            </tr>

                            <tr>
                                <td class="table-code-highlight">PR-712</td>
                                <td>Philippine Airlines</td>
                                <td>BSA (Bacolod)</td>
                                <td>GPRA (Caticlan)</td>
                                <td class="table-code-highlight">07:55 PM</td>
                                <td>PHP 2,900</td>
                                <td class="text-center">
                                    <span class="status-badge cancelled">Cancelled</span>
                                </td>
                                <td><button class="edit-button table-btn" onclick="openModal('modal-edit-flight')">Edit</button></td>
                                <td><button class="cancel-button table-btn" onclick="openModal('modal-cancel-flight')">Cancel</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>



            <!-- Modals-->



            <!-- Cancellation of Reservation Modal -->
            <div id="modal-cancel-flight" class="modal-overlay">
                <div class="modal-content-box-small">
                    <h2>CANCELLATION OF FLIGHT</h3>
                    <p>
                        Proceed with cancelling this flight?
                    </p>

                    <div class="options-group">
                        <button class="cancellation-modal-yes-btn" onclick="closeModal('modal-cancel-flight')">Yes, Cancel Flight</button>
                        <button class="cancellation-modal-no-btn" onclick="closeModal('modal-cancel-flight')">No, Keep Flight</button>
                    </div>
                </div>
            </div>

            <!-- Save Changes Modal -->
            <div id="modal-edit-save" class="modal-overlay">
                <div class="modal-content-box-small">
                    <h2>SAVE CHANGES</h3>
                    <p>
                        Proceed with updated changes?
                    </p>

                    <div class="options-group">
                        <button class="cancellation-modal-yes-btn" onclick="closeModal('modal-edit-save')">Yes, Save</button>
                        <button class="cancellation-modal-no-btn" onclick="closeModal('modal-edit-save')">No, Keep Editing</button>
                    </div>
                </div>
            </div>

            <!-- Edit Reservation Modal -->
            <div id="modal-edit-flight" class="modal-overlay">
                <div class="modal-content-box-small">
                    <h2>EDIT FLIGHT</h2>
                    
                    <form class="modal-form-grid" id="editReservationForm">
                        <div class="form-group grid-col-2">
                            <label for="edit-flight-code">Flight Number</label>
                            <input type="text" id="edit-flight-passenger-code" placeholder="PR-2968">
                        </div>

                        <div class="form-group">
                            <label for="edit-flight-airline">Airline</label>
                            <select id="edit-flight-airline" value="None">
                                <option value="None">None</option>
                                <option value="Philippine Airlines (PAL)">Philippine Airlines (PAL)</option>
                                <option value="Cebu Pacific (CP)">Cebu Pacific (CP)</option>
                                <option value="Cathay Pacific (CP)">Cathay Pacific (CP)</option>
                                <option value="Air Asia (AA)">Air Asia (AA)</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="edit-flight-departure-time">Departure Time</label>
                            <input type="time" id="edit-flight-departure-time">
                        </div>

                        <div class="form-group">
                            <label for="edit-flight-origin">Origin Airport</label>
                            <select id="edit-flight-airline" value="None">
                                <option value="None">None</option>
                                <option value="NAIA (Manila)">NAIA (Manila)</option>
                                <option value="IA (Albay)">BIA (Albay)</option>
                                <option value="MCIA (Cebu)">MCIA (Cebu)</option>
                                <option value="CIA (Clark)">CIA (Clark)</option>
                                <option value="BSA (Bacolod)">BSA (Bacolod)</option>
                                <option value="IIA (Iloilo)">IIA (Iloilo)</option>
                                <option value="SA (Siargao)">SA (Siargao)</option>
                                <option value="GPRA (Caticlan)">GPRA (Caticlan)</option>
                            </select>
                        </div>



                        <div class="form-group">
                            <label for="edit-flight-destination">Destination Airport</label>
                            <select id="edit-flight-destination" value="None">
                                <option value="None">None</option>
                                <option value="NAIA (Manila)">NAIA (Manila)</option>
                                <option value="IA (Albay)">BIA (Albay)</option>
                                <option value="MCIA (Cebu)">MCIA (Cebu)</option>
                                <option value="CIA (Clark)">CIA (Clark)</option>
                                <option value="BSA (Bacolod)">BSA (Bacolod)</option>
                                <option value="IIA (Iloilo)">IIA (Iloilo)</option>
                                <option value="SA (Siargao)">SA (Siargao)</option>
                                <option value="GPRA (Caticlan)">GPRA (Caticlan)</option>
                            </select>
                        </div>


                        
                        <div class="form-group grid-col-2">
                            <label for="edit-flight-price">Price (PHP)</label>
                            <input type="number" id="edit-flight-price" placeholder="12,350.50">
                        </div>

                        <div class="form-group">
                            <label for="statusFilter">Status</label>
                            <select id="statusFilter">
                                <option value="None">None</option>
                                <option value="Confirmed">Available</option>
                                <option value="Pending">Delayed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </form>

                    <div class="options-group">
                        <button class="save-button" onclick="saveFlightModal()">Save Changes</button>
                        <button class="cancel-button" onclick="closeModal('modal-edit-flight')">Cancel</button>
                    </div>
                </div>
            </div>
        </main>

    </div>
</div>

