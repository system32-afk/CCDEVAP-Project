
<!-- CSS -->
<link rel="stylesheet" href="/CSS/Booking_Style.css" media="all">


<!-- Hero Banner -->
<div class="hero-banner">
    <h1>Book Your Flight</h1>
</div>

<div class="container my-5">

    <input type="hidden" id="flight-id" value="{{flightId}}">

    <div class="row g-4">
        <div class="col-lg-9">

            <!-- Passenger Cards List -->
            <div id="passenger-list" class="row row-cols-1 row-cols-md-3 g-3">

                <!-- Dyanmic Cards -->

            </div>

            <!-- Passenger Form -->
            <div id="passenger-form">

                <!-- Progress Bar -->
                <div class="progress mb-4">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 25%;"></div>
                </div>

                <!-- Passenger Details -->
                <div class="passenger-step" id="passenger-step-1">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Passenger Details</h5>
                            <hr>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label>Full Name</label>
                                    <input type="text" class="form-control" id="full-name" pattern="[a-zA-Z\s]+" required>
                                    <p class="text-danger inline-validation" id="err-full-name">Valid name is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Email Address</label>
                                    <input type="email" class="form-control" id="email" required>
                                    <p class="text-danger inline-validation" id="err-email">Valid email is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Contact Number</label>
                                    <input type="number" class="form-control" id="contact" required>
                                    <p class="text-danger inline-validation" id="err-contact">Contact number is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Passport Number</label>
                                    <input type="text" class="form-control" id="passport" required>
                                    <p class="text-danger inline-validation" id="err-passport">Passport number is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Nationality</label>
                                    <select class="form-select" id="nationality" required>
                                        <option value="">Select Nationality</option>
                                        <option value="american">American</option>
                                        <option value="chinese">Chinese</option>
                                        <option value="filipino">Filipino</option>
                                        <option value="japanese">Japanese</option>
                                        <option value="korean">Korean</option>
                                    </select>
                                    <p class="text-danger inline-validation" id="err-nationality">Nationality is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Date of Birth</label>
                                    <input type="date" class="form-control" id="birthdate" required>
                                    <p class="text-danger inline-validation" id="err-birthdate">A valid date of birth is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Gender</label>
                                    <select class="form-select" id="gender" required>
                                        <option value="">Select Gender</option>
                                        <option value="male">Male</option>
                                        <option value="female">Female</option>
                                        <option value="other">Other</option>
                                        <option value="prefer-not">Prefer not to say</option>
                                    </select>
                                    <p class="text-danger inline-validation" id="err-gender">Gender is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Emergency Contact</label>
                                    <input type="number" class="form-control" id="emergency-contact" required>
                                    <p class="text-danger inline-validation" id="err-emergency">Emergency contact is required.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-1" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-next-1" class="btn btn-primary">Next</button>
                    </div>
                </div>

                <!-- Meal Selection -->
                <div class="passenger-step" id="passenger-step-2">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Meal Selection</h5>
                            <hr>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="standard">
                                        <div class="card-body">
                                            <p class="option-name">Standard</p>
                                            <hr>
                                            <p class="option-desc">A balanced meal with meat, rice, and vegetables.</p>
                                            <p class="option-cost mb-0">Included</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="vegetarian">
                                        <div class="card-body">
                                            <p class="option-name">Vegetarian</p>
                                            <hr>
                                            <p class="option-desc">Plant-based meal with no meat or seafood.</p>
                                            <p class="option-cost mb-0">+₱150</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="vegan">
                                        <div class="card-body">
                                            <p class="option-name">Vegan</p>
                                            <hr>
                                            <p class="option-desc">100% plant-based, no animal products whatsoever.</p>
                                            <p class="option-cost mb-0">+₱200</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="halal">
                                        <div class="card-body">
                                            <p class="option-name">Halal</p>
                                            <hr>
                                            <p class="option-desc">Prepared in accordance with Islamic dietary laws.</p>
                                            <p class="option-cost mb-0">+₱100</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="kosher">
                                        <div class="card-body">
                                            <p class="option-name">Kosher</p>
                                            <hr>
                                            <p class="option-desc">Prepared in accordance with Jewish dietary laws.</p>
                                            <p class="option-cost mb-0">+₱350</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="gluten-free">
                                        <div class="card-body">
                                            <p class="option-name">Gluten-Free</p>
                                            <hr>
                                            <p class="option-desc">No gluten-containing ingredients, suitable for celiac.</p>
                                            <p class="option-cost mb-0">+₱300</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <p class="text-danger inline-validation" id="err-meal">Please select a meal.</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-2" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-next-2" class="btn btn-primary">Next</button>
                    </div>
                </div>

                <!-- Seat Selection -->
                <div class="passenger-step" id="passenger-step-3">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Seat Selection</h5>
                            <hr>
                            <div class="d-flex gap-3 flex-wrap mb-3 justify-content-center">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend available"></span>
                                    <p class="passenger-detail">Available</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend occupied"></span>
                                    <p class="passenger-detail">Occupied</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend selected"></span>
                                    <p class="passenger-detail">Selected</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend premium"></span>
                                    <p class="passenger-detail">Premium (+500)</p>
                                </div>
                            </div>

                            <p class="option-desc text-center">Selected Seat: <span class="option-name" id="selected-seat-display">None</span></p>

                            <div class="d-flex justify-content-center">
                                <div class="seat-map">
                                    <p class="option-desc seat-select text-center">FRONT OF THE PLANE</p>
                                    <hr>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label"></div>
                                        <div class="seat-cell text-muted small fw-bold">A</div>
                                        <div class="seat-cell text-muted small fw-bold">B</div>
                                        <div class="seat-cell text-muted small fw-bold">C</div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell text-muted small fw-bold">D</div>
                                        <div class="seat-cell text-muted small fw-bold">E</div>
                                        <div class="seat-cell text-muted small fw-bold">F</div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">1</div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="1A" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 1A - Premium"></div></div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="1B" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 1B - Premium"></div></div>
                                        <div class="seat-cell"><div class="seat premium occupied" data-seat="1C" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 1C - Occupied"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="1D" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 1D - Premium"></div></div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="1E" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 1E - Premium"></div></div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="1F" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 1F - Premium"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">2</div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="2A" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 2A - Premium"></div></div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="2B" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 2B - Premium"></div></div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="2C" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 2C - Premium"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat premium occupied" data-seat="2D" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 2D - Occupied"></div></div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="2E" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 2E - Premium"></div></div>
                                        <div class="seat-cell"><div class="seat premium" data-seat="2F" data-premium="true" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 2F - Premium"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1 mt-2">
                                        <div class="seat-row-label text-muted small fw-bold">3</div>
                                        <div class="seat-cell"><div class="seat available" data-seat="3A" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 3A - Available"></div></div>
                                        <div class="seat-cell"><div class="seat occupied" data-seat="3B" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 3B - Occupied"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="3C" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 3C - Available"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="3D" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 3D - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="3E" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 3E - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="3F" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 3F - Available"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">4</div>
                                        <div class="seat-cell"><div class="seat available" data-seat="4A" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 4A - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="4B" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 4B - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="4C" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 4C - Available"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat occupied" data-seat="4D" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 4D - Occupied"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="4E" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 4E - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="4F" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 4F - Available"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">5</div>
                                        <div class="seat-cell"><div class="seat occupied" data-seat="5A" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 5A - Occupied"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="5B" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 5B - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="5C" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 5C - Available"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="5D" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 5D - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="5E" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 5E - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="5F" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 5F - Available"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">6</div>
                                        <div class="seat-cell"><div class="seat available" data-seat="6A" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 6A - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="6B" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 6B - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="6C" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 6C - Available"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="6D" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 6D - Available"></div></div>
                                        <div class="seat-cell"><div class="seat occupied" data-seat="6E" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 6E - Occupied"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="6F" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 6F - Available"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">7</div>
                                        <div class="seat-cell"><div class="seat available" data-seat="7A" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 7A - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="7B" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 7B - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="7C" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 7C - Available"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="7D" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 7D - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="7E" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 7E - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="7F" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 7F - Available"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">8</div>
                                        <div class="seat-cell"><div class="seat available" data-seat="8A" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 8A - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="8B" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 8B - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="8C" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 8C - Available"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="8D" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 8D - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="8E" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 8E - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="8F" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 8F - Available"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">9</div>
                                        <div class="seat-cell"><div class="seat available" data-seat="9A" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 9A - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="9B" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 9B - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="9C" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 9C - Available"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="9D" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 9D - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="9E" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 9E - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="9F" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 9F - Available"></div></div>
                                    </div>

                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label text-muted small fw-bold">10</div>
                                        <div class="seat-cell"><div class="seat available" data-seat="10A" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 10A - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="10B" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 10B - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="10C" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 10C - Available"></div></div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="10D" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 10D - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="10E" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 10E - Available"></div></div>
                                        <div class="seat-cell"><div class="seat available" data-seat="10F" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Seat 10F - Available"></div></div>
                                    </div>
                                </div>
                            </div>

                            <p class="text-danger inline-validation text-center" id="err-seat">Please select a seat.</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-3" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-next-3" class="btn btn-primary">Next</button>
                    </div>
                    
                </div>

                <!-- Extra Services -->
                <div class="passenger-step" id="passenger-step-4">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Extra Services</h5>
                            <hr>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100" 
                                        data-bs-toggle="tooltip" data-bs-placement="top" 
                                        data-bs-title="Add up to 3 extra bags, 20kg each.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Additional Baggage</p>
                                                <hr>
                                                <p class="option-cost">+₱300 per bag</p>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <button id="baggage-minus" class="btn btn-outline-secondary btn-sm">−</button>
                                                <span id="baggage-count">0</span>
                                                <button id="baggage-plus" class="btn btn-outline-secondary btn-sm">+</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100" 
                                        data-bs-toggle="tooltip" data-bs-placement="top" 
                                        data-bs-title="Board the plane before general passengers.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Priority Boarding</p>
                                                <hr>
                                                <p class="option-cost">+₱250</p>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="priority-toggle">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100"
                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                        data-bs-title="Coverage for delays, cancellations, and medical.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Travel Insurance</p>
                                                <hr>
