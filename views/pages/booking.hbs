
<!-- CSS -->
<link rel="stylesheet" href="/CSS/Booking_Style.css" media="all">


<!-- Hero Banner -->
<div class="hero-banner">
    <h1>Book Your Flight</h1>
</div>

<div class="container my-5">

    <input type="hidden" id="flight-id" value="{{flightId}}">
    <!-- flight id passed from server -->
    <input type="hidden" id="return-flight-id" value="{{returnFlightId}}">

    <div class="row g-4">
        <div class="col-lg-9">

            <!-- Passenger Cards List -->
            <div id="passenger-list" class="row row-cols-1 row-cols-md-3 g-3">

                <!-- Dynamic Cards -->

            </div>

            <!-- Passenger Form -->
            <div id="passenger-form">

                <!-- Progress Bar -->
                <div class="progress mb-4">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 25%;"></div>
                </div>

                <!-- Passenger Details -->
                <div class="passenger-step" id="passenger-step-1">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Passenger Details</h5>
                            <hr>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label>Full Name</label>
                                    <input type="text" class="form-control" id="full-name" pattern="[a-zA-Z\s]+" required>
                                    <p class="text-danger inline-validation" id="err-full-name">Valid name is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Email Address</label>
                                    <input type="email" class="form-control" id="email" required>
                                    <p class="text-danger inline-validation" id="err-email">Valid email is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Contact Number</label>
                                    <input type="number" class="form-control" id="contact" required>
                                    <p class="text-danger inline-validation" id="err-contact">Contact number is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Passport Number</label>
                                    <input type="text" class="form-control" id="passport" required>
                                    <p class="text-danger inline-validation" id="err-passport">Passport number is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Nationality</label>
                                    <select class="form-select" id="nationality" required>
                                        <option value="">Select Nationality</option>
                                        <option value="american">American</option>
                                        <option value="chinese">Chinese</option>
                                        <option value="filipino">Filipino</option>
                                        <option value="japanese">Japanese</option>
                                        <option value="korean">Korean</option>
                                    </select>
                                    <p class="text-danger inline-validation" id="err-nationality">Nationality is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Date of Birth</label>
                                    <input type="date" class="form-control" id="birthdate" required>
                                    <p class="text-danger inline-validation" id="err-birthdate">A valid date of birth is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Gender</label>
                                    <select class="form-select" id="gender" required>
                                        <option value="">Select Gender</option>
                                        <option value="male">Male</option>
                                        <option value="female">Female</option>
                                        <option value="other">Other</option>
                                        <option value="prefer-not">Prefer not to say</option>
                                    </select>
                                    <p class="text-danger inline-validation" id="err-gender">Gender is required.</p>
                                </div>

                                <div class="col-md-6">
                                    <label>Emergency Contact</label>
                                    <input type="number" class="form-control" id="emergency-contact" required>
                                    <p class="text-danger inline-validation" id="err-emergency">Emergency contact is required.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-1" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-next-1" class="btn btn-primary">Next</button>
                    </div>
                </div>

                <!-- Departure Meal Selection -->
                <div class="passenger-step" id="passenger-step-2">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Departure - Meal Selection</h5>
                            <hr>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="standard">
                                        <div class="card-body">
                                            <p class="option-name">Standard</p>
                                            <hr>
                                            <p class="option-desc">A balanced meal with meat, rice, and vegetables.</p>
                                            <p class="option-cost mb-0">Included</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="vegetarian">
                                        <div class="card-body">
                                            <p class="option-name">Vegetarian</p>
                                            <hr>
                                            <p class="option-desc">Plant-based meal with no meat or seafood.</p>
                                            <p class="option-cost mb-0">+₱150</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="vegan">
                                        <div class="card-body">
                                            <p class="option-name">Vegan</p>
                                            <hr>
                                            <p class="option-desc">100% plant-based, no animal products whatsoever.</p>
                                            <p class="option-cost mb-0">+₱200</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="halal">
                                        <div class="card-body">
                                            <p class="option-name">Halal</p>
                                            <hr>
                                            <p class="option-desc">Prepared in accordance with Islamic dietary laws.</p>
                                            <p class="option-cost mb-0">+₱100</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="kosher">
                                        <div class="card-body">
                                            <p class="option-name">Kosher</p>
                                            <hr>
                                            <p class="option-desc">Prepared in accordance with Jewish dietary laws.</p>
                                            <p class="option-cost mb-0">+₱350</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card meal-option" data-meal="gluten-free">
                                        <div class="card-body">
                                            <p class="option-name">Gluten-Free</p>
                                            <hr>
                                            <p class="option-desc">No gluten-containing ingredients, suitable for celiac.</p>
                                            <p class="option-cost mb-0">+₱300</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <p class="text-danger inline-validation" id="err-meal">Please select a meal.</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-2" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-next-2" class="btn btn-primary">Next</button>
                    </div>
                </div>

                <!-- Departure Seat Selection -->
                <div class="passenger-step" id="passenger-step-3">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Departure - Seat Selection</h5>
                            <hr>
                            <div class="d-flex gap-3 flex-wrap mb-3 justify-content-center">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend available"></span>
                                    <p class="passenger-detail">Available</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend occupied"></span>
                                    <p class="passenger-detail">Occupied</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend selected"></span>
                                    <p class="passenger-detail">Selected</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend premium"></span>
                                    <p class="passenger-detail">Premium (+500)</p>
                                </div>
                            </div>

                            <p class="option-desc text-center">Selected Seat: <span class="option-name" id="selected-seat-display">None</span></p>

                            <div class="d-flex justify-content-center">
                                <div class="seat-map" id="departure-seat-map">
                                    <p class="option-desc seat-select text-center">FRONT OF THE PLANE</p>
                                    <hr>
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label"></div>
                                        <div class="seat-cell text-muted small fw-bold">A</div>
                                        <div class="seat-cell text-muted small fw-bold">B</div>
                                        <div class="seat-cell text-muted small fw-bold">C</div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell text-muted small fw-bold">D</div>
                                        <div class="seat-cell text-muted small fw-bold">E</div>
                                        <div class="seat-cell text-muted small fw-bold">F</div>
                                    </div>
                                    <!-- rows injected by JS -->
                                </div>
                            </div>

                            <p class="text-danger inline-validation text-center" id="err-seat">Please select a seat.</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-3" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-next-3" class="btn btn-primary">Next</button>
                    </div>
                </div>

                <!-- Departure Extra Services -->
                <div class="passenger-step" id="passenger-step-4">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Departure - Extra Services</h5>
                            <hr>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100" 
                                        data-bs-toggle="tooltip" data-bs-placement="top" 
                                        data-bs-title="Add up to 3 extra bags, 20kg each.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Additional Baggage</p>
                                                <hr>
                                                <p class="option-cost">+₱300 per bag</p>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <button id="baggage-minus" class="btn btn-outline-secondary btn-sm">−</button>
                                                <span id="baggage-count">0</span>
                                                <button id="baggage-plus" class="btn btn-outline-secondary btn-sm">+</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100" 
                                        data-bs-toggle="tooltip" data-bs-placement="top" 
                                        data-bs-title="Board the plane before general passengers.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Priority Boarding</p>
                                                <hr>
                                                <p class="option-cost">+₱250</p>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="priority-toggle">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100"
                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                        data-bs-title="Coverage for delays, cancellations, and medical.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Travel Insurance</p>
                                                <hr>
                                                <p class="option-cost">+₱400</p>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="insurance-toggle">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100"
                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                        data-bs-title="Access to premium airport lounge before your flight.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Lounge Access</p>
                                                <hr>
                                                <p class="option-cost">+₱600</p>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="lounge-toggle">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-4" class="btn btn-outline-secondary">Back</button>
                        <!-- for one way this acts as done, for roundtrip it goes to step 5 -->
                        <button id="btn-next-4" class="btn btn-primary">Next</button>
                    </div>
                </div>

                <!-- Return Meal Selection (roundtrip) -->
                <div class="passenger-step" id="passenger-step-5">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Return - Meal Selection</h5>
                            <hr>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="card rt-meal-option" data-meal="standard">
                                        <div class="card-body">
                                            <p class="option-name">Standard</p>
                                            <hr>
                                            <p class="option-desc">A balanced meal with meat, rice, and vegetables.</p>
                                            <p class="option-cost mb-0">Included</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card rt-meal-option" data-meal="vegetarian">
                                        <div class="card-body">
                                            <p class="option-name">Vegetarian</p>
                                            <hr>
                                            <p class="option-desc">Plant-based meal with no meat or seafood.</p>
                                            <p class="option-cost mb-0">+₱150</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card rt-meal-option" data-meal="vegan">
                                        <div class="card-body">
                                            <p class="option-name">Vegan</p>
                                            <hr>
                                            <p class="option-desc">100% plant-based, no animal products whatsoever.</p>
                                            <p class="option-cost mb-0">+₱200</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card rt-meal-option" data-meal="halal">
                                        <div class="card-body">
                                            <p class="option-name">Halal</p>
                                            <hr>
                                            <p class="option-desc">Prepared in accordance with Islamic dietary laws.</p>
                                            <p class="option-cost mb-0">+₱100</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card rt-meal-option" data-meal="kosher">
                                        <div class="card-body">
                                            <p class="option-name">Kosher</p>
                                            <hr>
                                            <p class="option-desc">Prepared in accordance with Jewish dietary laws.</p>
                                            <p class="option-cost mb-0">+₱350</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card rt-meal-option" data-meal="gluten-free">
                                        <div class="card-body">
                                            <p class="option-name">Gluten-Free</p>
                                            <hr>
                                            <p class="option-desc">No gluten-containing ingredients, suitable for celiac.</p>
                                            <p class="option-cost mb-0">+₱300</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <p class="text-danger inline-validation" id="err-rt-meal">Please select a meal.</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-5" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-next-5" class="btn btn-primary">Next</button>
                    </div>
                </div>

                <!-- Return Seat Selection (roundtrip) -->
                <div class="passenger-step" id="passenger-step-6">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Return - Seat Selection</h5>
                            <hr>
                            <div class="d-flex gap-3 flex-wrap mb-3 justify-content-center">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend available"></span>
                                    <p class="passenger-detail">Available</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend occupied"></span>
                                    <p class="passenger-detail">Occupied</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend selected"></span>
                                    <p class="passenger-detail">Selected</p>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="seat-legend premium"></span>
                                    <p class="passenger-detail">Premium (+500)</p>
                                </div>
                            </div>

                            <p class="option-desc text-center">Selected Return Seat: <span class="option-name" id="rt-selected-seat-display">None</span></p>

                            <div class="d-flex justify-content-center">
                                <div class="seat-map" id="return-seat-map">
                                    <p class="option-desc seat-select text-center">FRONT OF THE PLANE</p>
                                    <hr>
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <div class="seat-row-label"></div>
                                        <div class="seat-cell text-muted small fw-bold">A</div>
                                        <div class="seat-cell text-muted small fw-bold">B</div>
                                        <div class="seat-cell text-muted small fw-bold">C</div>
                                        <div class="seat-aisle"></div>
                                        <div class="seat-cell text-muted small fw-bold">D</div>
                                        <div class="seat-cell text-muted small fw-bold">E</div>
                                        <div class="seat-cell text-muted small fw-bold">F</div>
                                    </div>
                                    <!-- rows injected by JS -->
                                </div>
                            </div>

                            <p class="text-danger inline-validation text-center" id="err-rt-seat">Please select a return seat.</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-6" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-next-6" class="btn btn-primary">Next</button>
                    </div>
                </div>

                <!-- Return Extra Services (roundtrip) -->
                <div class="passenger-step" id="passenger-step-7">
                    <div class="card form-card">
                        <div class="card-body">
                            <h5 class="card-title">Return - Extra Services</h5>
                            <hr>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100"
                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                        data-bs-title="Add up to 3 extra bags, 20kg each.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Additional Baggage</p>
                                                <hr>
                                                <p class="option-cost">+₱300 per bag</p>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <button id="rt-baggage-minus" class="btn btn-outline-secondary btn-sm">−</button>
                                                <span id="rt-baggage-count">0</span>
                                                <button id="rt-baggage-plus" class="btn btn-outline-secondary btn-sm">+</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100"
                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                        data-bs-title="Board the plane before general passengers.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Priority Boarding</p>
                                                <hr>
                                                <p class="option-cost">+₱250</p>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="rt-priority-toggle">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100"
                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                        data-bs-title="Coverage for delays, cancellations, and medical.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Travel Insurance</p>
                                                <hr>
                                                <p class="option-cost">+₱400</p>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="rt-insurance-toggle">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card extra-service-card h-100"
                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                        data-bs-title="Access to premium airport lounge before your flight.">
                                        <div class="card-body d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="option-name">Lounge Access</p>
                                                <hr>
                                                <p class="option-cost">+₱600</p>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="rt-lounge-toggle">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button id="btn-back-7" class="btn btn-outline-secondary">Back</button>
                        <button id="btn-done" class="btn btn-primary">Done</button>
                    </div>
                </div>

            </div>

            <!-- Outside Buttons -->
            <div id="outside-buttons">
                <div class="mt-3">
                    <button id="btn-search" class="btn btn-outline-secondary">Search Flights</button>
                    <button id="btn-confirm" class="btn btn-primary">Confirm</button>
                </div>
            </div>

        </div>

        <!-- Booking Summary Sidebar -->
        <div class="col-lg-3">
            <div class="card summary-card sticky-top">
                <div class="card-body">
                    <h5 class="card-title">Booking Summary</h5>
                    <hr>

                    <!-- Departure Flight Details -->
                    <p class="summary-section-label">Departure Flight</p>

                    <div class="d-flex justify-content-between mb-1">
                        <p class="summary-section-detail text-muted">Flight</p>
                        <p class="passenger-detail" id="summary-flight">-</p>
                    </div>

                    <div class="d-flex justify-content-between mb-1">
                        <p class="summary-section-detail text-muted">Route</p>
                        <p class="passenger-detail" id="summary-route">-</p>
                    </div>

                    <div class="d-flex justify-content-between mb-1">
                        <p class="summary-section-detail text-muted">Departure</p>
                        <p class="passenger-detail" id="summary-departure">-</p>
                    </div>

                    <div class="d-flex justify-content-between mb-1">
                        <p class="summary-section-detail text-muted">Arrival</p>
                        <p class="passenger-detail" id="summary-arrival">-</p>
                    </div>

                    <div class="d-flex justify-content-between mb-1">
                        <p class="summary-section-detail text-muted">Duration</p>
                        <p class="passenger-detail" id="summary-duration">-</p>
                    </div>

                    <!-- Return Flight Details (roundtrip) -->
                    <div id="return-flight-details" style="display:none;">
                        <hr>
                        <p class="summary-section-label">Return Flight</p>

                        <div class="d-flex justify-content-between mb-1">
                            <p class="summary-section-detail text-muted">Flight</p>
                            <p class="passenger-detail" id="summary-return-flight">-</p>
                        </div>

                        <div class="d-flex justify-content-between mb-1">
                            <p class="summary-section-detail text-muted">Route</p>
                            <p class="passenger-detail" id="summary-return-route">-</p>
                        </div>

