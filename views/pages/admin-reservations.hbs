
    <link rel="stylesheet" href="/CSS/reservations.css" media="all">
    <link rel="stylesheet" href="/CSS/admin.css" media="all">
    <link rel="stylesheet" href="/CSS/Booking_Style.css" media="all">

<div id="navbar"></div>

<div class="container-fluid content-section">
    <div class="row">
        <aside class="admin-sidebar">
            <ul class="nav flex-column admin-sidebar-nav gap-1">
                <li class="nav-item">
                    <a href="admin-dashboard" class="nav-link rounded">
                        <img src="/images/dashboard-icon.png">
                        Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a href="admin-flights" class="nav-link rounded">
                        <img src="/images/flight-management-icon.png">
                        Flight Management
                    </a>
                </li>
                <li class="nav-item">
                    <a href="admin-users" class="nav-link rounded">
                        <img src="/images/user-management-icon.png">
                        User Management
                    </a>
                </li>
                <li class="nav-item">
                    <a href="admin-reservations" class="nav-link active rounded">
                        <img src="/images/reservation-management-icon.png">
                        Reservations Management
                    </a>
                </li>
            </ul>
        </aside>

        <main class="admin-content">
            <h1 class="admin-title"><strong>RESERVATION MANAGEMENT</strong></h1>

            <div class="search-container">
                <form id="searchAndSortForm">
                <div class="form-group">
                    <label>Departure:</label>
                    <select id="departure-airports">
                        <option value="None">None</option>
                        {{#each cities}}
                        <option value="{{this.cityName}}">{{this.cityName}}</option>
                        {{/each}}
                    </select>
                </div> 

                <button type="button" id="swapBtn" onclick="swapLocations()">
                    <img src="/images/swap-icon.avif">
                </button>

                <div class="form-group">
                    <label>Destination:</label>
                    <select id="destination-airports">
                        <option value="None">None</option>
                        {{#each cities}}
                        <option value="{{this.cityName}}">{{this.cityName}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="form-group">
                    <label>Flight Number: </label>
                    <input type="text" id="flightNumber" placeholder="None">
                </div>

                <div class="form-group">
                    <label>Booking Reference: </label>
                    <input type="text" id="bookingReference" placeholder="None">
                </div>

                <div class="form-group">
                    <label class="departure-date">Departure Date:</label>
                    <input id="departureDate" type="date">
                </div>

                <div class="form-group">
                    <label>Sort By:</label>
                    <select id="sortBy">
                        <option value="">None</option>
                        <option value="dateAsc">Departure Date: Oldest First</option>
                        <option value="dateDesc">Departure Date: Newest First</option>
                        <option value="priceAsc">Price: Lowest First</option>
                        <option value="priceDesc">Price: Highest First</option>
                        <option value="flightAsc">Flight Duration: Shortest First</option>
                        <option value="flightDesc">Flight Duration: Longest First</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Status:</label>
                    <select id="statusFilter">
                        <option value="">All</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Pending">Pending</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                </form>
            </div>
            
            <div class="search-flight">
                <button class="btn btn-primary" id="sortReservations">Search Reservations</a>
            </div><br>
                
            <div class="analytics-table-card">
                <div class="table-responsive">
                    <table class="table table-hover admin-table">
                        <thead>
                            <tr>
                                <th scope="col">Booking Reference</th>
                                <th scope="col">Passenger Name</th>
                                <th scope="col">Date</th>
                                <th scope="col">Status</th>
                                <th scope="col"></th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody id="reservationAdminContainer">
        
                        </tbody>
                    </table>
                </div>
            </div>

        <div id="modalContainer">
            {{!-- reservation detail modals get injected here by reservationsRenderAdmin.js --}}
        </div>

        <!-- Cancellation of Reservation Modal -->
        <div id="modal-cancel" class="modal-overlay">
            <div class="modal-content-box-small">
                <h2>CHANGE STATUS OF RESERVATION</h2>
                <p id="modal-cancel-message">
                    <!-- Message is dynamic -->
                </p>

                <div class="options-group">
                    <button class="cancellation-modal-yes-btn" onclick="confirmStatusChange()">Yes, Change Status</button>
                    <button class="cancellation-modal-no-btn" onclick="cancelStatusChange()">No, Keep Status</button>
                </div>
            </div>
        </div>

    </main>

    </div>
</div>
