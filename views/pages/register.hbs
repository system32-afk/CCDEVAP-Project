
<link rel="stylesheet" href="CSS/landing.css">

<div id="reg-form">
    <form action="">
        <div id="personal-info-details">
            <div class="row g-3">

                <div class="col-md-5">
                    <label for="Fname-field" class="form-label">First Name</label>
                    <input type="text" id="Fname-field" data-field="Fname" class="form-control py-2" value="" required>
                </div>

                <div class="col-md-5">
                    <label for="Lname-field" class="form-label">Last Name</label>
                    <input type="text" id="Lname-field" data-field="Lname" class="form-control py-2" value="" required>
                </div>

                <div class="col-md-2">
                    <label for="MI-field" class="form-label">M.I.</label>
                    <input type="text" id="MI-field" data-field="MI" class="form-control py-2" value="" maxlength="1"
                        pattern="[A-Za-z]+" title="Only letters are allowed" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Sex</label>
                    <select id="sex-field" data-field="sex" class="form-control" required>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="mobile-number-field" class="form-label">Mobile Number</label>
                    <div class="input-group">
                        <span class="input-group-text">+63</span>
                        <input type="number" class="form-control no-spinners py-2" id="mobile-number-field"
                            data-field="mobileNum" value="" required>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="DOB-field" class="form-label">Date of Birth</label>
                    <input type="number" class="form-control no-spinners py-2" id="DOB-field" data-field="DOB" value=""
                        placeholder="YYYY/MM/DD" required>
                </div>

                <div class="col-md-6">
                    <label for="Nationality-field" class="form-label">Nationality</label>
                    <input type="text" id="Nationality-field" data-field="nationality" class="form-control py-2"
                        value="" required>
                </div>

                <div class="col-md-6">
                    <label for="email-field" class="form-label">Email Address</label>
                    <input type="email" id="email-field" data-field="emailAddress" class="form-control py-2" value=""
                        required>
                </div>
                <div class="col-md-6">
                    <label for="Nationality-field" class="form-label">Password</label>
                    <input type="text" id="password-field" data-field="password" class="form-control py-2" value=""
                        required>
                </div>

                <div class="col-12 mt-4 d-none pb-3" id="edit-actions-container">
                    <button type="button" id="save-changes" class="btn btn-success btn-sm px-1 py-3 me-2">Save
                        Changes</button>
                    <button type="button" id="cancel-edit" class="btn btn-light btn-sm py-1 px-3">Cancel</button>
                </div>

            <div class="row mt-3">
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-secondary" href="login">Cancel</a>
                    <button type="submit" class="btn btn-primary">Register</button>
                </div>
            </div>
                


            </div>
        </div>
    </form>