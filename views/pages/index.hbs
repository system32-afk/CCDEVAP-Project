<!-- Promotional Cards/Carousel -->
 <h1 class="carousel-header">Best Deals</h1>
   <div id="promo-destinations" class="carousel slide carousel-fade" data-bs-ride="carousel">

  <div class="carousel-indicators">
    <button type="button" data-bs-target="#promo-destinations" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#promo-destinations" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#promo-destinations" data-bs-slide-to="2" aria-label="Slide 3"></button>
  </div>
  <div class="carousel-inner">
    <div class="carousel-item active" data-bs-interval="2500">
