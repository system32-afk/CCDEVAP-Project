      <div class="carousel-caption d-none d-md-block">
        <h5>Tokyo, Japan</h5>
        <p>Experience the magic of Tokyo.</p>
      </div>
    </div>
    <div class="carousel-item"  data-bs-interval="2500">
      <img src="/images/paris-promo.jpg" class="d-block w-100" alt="Paris-promo">
      <div class="carousel-caption d-none d-md-block">
        <h5>Paris, France</h5>
        <p>The City of Love and Lights.</p>
      </div>
    </div>
    <div class="carousel-item"  data-bs-interval="2500">
      <img src="/images/seoul-promo.jpg" class="d-block w-100" alt="Seoul-promo">
      <div class="carousel-caption d-none d-md-block">
        <h5>Seoul, South Korea</h5>
        <p>Discover the soul of Seoul.</p>
      </div>
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#promo-destinations" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#promo-destinations" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
<!-- end of Promotional Cards/Carousel -->

