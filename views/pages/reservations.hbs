    <!-- CSS File -->
    <link rel="stylesheet" href="/CSS/reservations.css" media="all">

    <main>
        
    <!-- search bar -->
    <div class="search-container">
        <form id="searchAndSortForm">
        <div class="form-group">
            <label>Departure:</label>
            <select id="departure-airports">
                <option value="None">None</option>
                <option value="NAIA (Manila)">NAIA (Manila)</option>
                <option value="IA (Albay)">BIA (Albay)</option>
                <option value="MCIA (Cebu)">MCIA (Cebu)</option>
                <option value="CIA (Clark)">CIA (Clark)</option>
                <option value="BSA (Bacolod)">BSA (Bacolod)</option>
                <option value="IIA (Iloilo)">IIA (Iloilo)</option>
                <option value="SA (Siargao)">SA (Siargao)</option>
                <option value="GPRA (Caticlan)">GPRA (Caticlan)</option>
            </select>
        </div> 

        <button type="button" id="swapBtn" onclick="swapLocations()">
            <img src="/images/swap-icon.avif">
        </button>

        <div class="form-group">
            <label>Destination:</label>
            <select id="destination-airports">
                <option value="None">None</option>
                <option value="NAIA (Manila)">NAIA (Manila)</option>
                <option value="IA (Albay)">BIA (Albay)</option>
                <option value="MCIA (Cebu)">MCIA (Cebu)</option>
                <option value="CIA (Clark)">CIA (Clark)</option>
                <option value="BSA (Bacolod)">BSA (Bacolod)</option>
                <option value="IIA (Iloilo)">IIA (Iloilo)</option>
                <option value="SA (Siargao)">SA (Siargao)</option>
                <option value="GPRA (Caticlan)">GPRA (Caticlan)</option>
            </select>
        </div>

        <div class="form-group">
            <label class="departure-date">Departure Date:</label>
            <input id="departureDate" type="date">
        </div>

        <div class="form-group">
            <label>Sort By:</label>
            <select id="sortBy">
                <option value="">None</option>
                <option value="dateAsc">Departure Date: Oldest First</option>
                <option value="dateDesc">Departure Date: Newest First</option>
                <option value="priceAsc">Price: Lowest First</option>
                <option value="priceDesc">Price: Highest First</option>
                <option value="flightAsc">Flight Duration: Shortest First</option>
                <option value="flightDesc">Flight Duration: Longest First</option>
            </select>
        </div>

        <div class="form-group">
            <label>Status:</label>
            <select id="statusFilter">
                <option value="">All</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Pending">Pending</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>

        </form>
    </div>
        

    </div>
        <div class="search-flight">
            <button class="btn btn-primary" id="sortReservations">Search Reservations</a>
        </div><br>

    <!-- Reservation Cards -->

    <h1 class="reservations-header">Your Reservations</h1>

    <div id="reservationContainer"></div>

    <!-- Cancellation of Reservation Modal -->
    <div id="modal-cancel" class="modal-overlay">
        <div class="modal-content-box-small">
            <h2>CANCELLATION OF RESERVATION</h3>
            <p">
                Proceed with cancelling this reservation?
            </p>

            <div class="options-group">
                <button class="cancellation-modal-yes-btn" onclick="closeModal('modal-cancel')">Yes, Cancel Reservation</button>
                <button class="cancellation-modal-no-btn" onclick="closeModal('modal-cancel')">No, Keep Reservation</button>
            </div>
        </div>
    </div>

    <!-- Save Changes Modal -->
    <div id="modal-edit-save" class="modal-overlay">
        <div class="modal-content-box-small">
            <h2>SAVE CHANGES</h3>
            <p">
                Proceed with updated changes?
            </p>

            <div class="options-group">
                <button class="cancellation-modal-yes-btn" onclick="closeModal('modal-edit-save')">Yes, Save</button>
                <button class="cancellation-modal-no-btn" onclick="closeModal('modal-edit-save')">No, Keep Editing</button>
            </div>
        </div>
    </div>

    <!-- Edit Reservation Modal -->
    <div id="modal-edit" class="modal-overlay">
        <div class="modal-content-box-small">
            <h2>EDIT RESERVATION</h2>
            
            <form class="modal-form-grid" id="editReservationForm">
                <div class="form-group">
                    <label for="edit-flight-passenger-name">Passenger Name</label>
                    <input type="text" id="edit-flight-passenger-name" placeholder="Juan Mario F. Reyes">
                </div>

                <div class="form-group">
                    <label for="statusFilter">Status</label>
                    <select id="statusFilter">
                        <option value="None">None</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Pending">Pending</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="edit-flight-number">Flight Number</label>
                    <input type="text" id="edit-flight-number" placeholder="Ex. PR-2032">
                </div>

                <div class="form-group">
                    <label for="edit-flight-airline">Airline</label>
                    <select id="edit-flight-airline" value="None">
                        <option value="None">None</option>
                        <option value="Philippine Airlines (PAL)">Philippine Airlines (PAL)</option>
                        <option value="Cebu Pacific (CP)">Cebu Pacific (CP)</option>
                        <option value="Cathay Pacific (CP)">Cathay Pacific (CP)</option>
                        <option value="Air Asia (AA)">Air Asia (AA)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="edit-flight-booking-number">Booking Reference</label>
                    <input type="text" id="edit-flight-booking-number" placeholder="Ex. BK-3927">
                </div>

                <div class="form-group">
                    <label for="edit-flight-date">Departure Date</label>
                    <input type="date" id="edit-flight-date">
                </div>

                <div class="form-group grid-col-2">
                    <label for="edit-flight-departure-time">Departure Time</label>
                    <input type="time" id="edit-flight-departure-time">
                </div>

                <div class="form-group">
                    <label for="edit-flight-origin">Origin Airport</label>
                    <select id="edit-flight-airline" value="None">
                        <option value="None">None</option>
                        <option value="NAIA (Manila)">NAIA (Manila)</option>
                        <option value="IA (Albay)">BIA (Albay)</option>
                        <option value="MCIA (Cebu)">MCIA (Cebu)</option>
                        <option value="CIA (Clark)">CIA (Clark)</option>
                        <option value="BSA (Bacolod)">BSA (Bacolod)</option>
                        <option value="IIA (Iloilo)">IIA (Iloilo)</option>
                        <option value="SA (Siargao)">SA (Siargao)</option>
                        <option value="GPRA (Caticlan)">GPRA (Caticlan)</option>
                    </select>
                </div>

                <div class="form-group grid-col-2">
                    <label for="edit-flight-arrival-time">Arrival Time</label>
                    <input type="time" id="edit-flight-arrival-time">
                </div>

                <div class="form-group">
                    <label for="edit-flight-destination">Destination Airport</label>
                    <select id="edit-flight-destination" value="None">
                        <option value="None">None</option>
                        <option value="NAIA (Manila)">NAIA (Manila)</option>
                        <option value="IA (Albay)">BIA (Albay)</option>
                        <option value="MCIA (Cebu)">MCIA (Cebu)</option>
                        <option value="CIA (Clark)">CIA (Clark)</option>
                        <option value="BSA (Bacolod)">BSA (Bacolod)</option>
                        <option value="IIA (Iloilo)">IIA (Iloilo)</option>
                        <option value="SA (Siargao)">SA (Siargao)</option>
                        <option value="GPRA (Caticlan)">GPRA (Caticlan)</option>
                    </select>
                </div>


                <div class="form-group grid-col-2">
                    <label for="edit-flight-duration">Duration (mins)</label>
                    <input type="number" id="edit-flight-duration" placeholder="Ex. 180">
                </div>

                <div class="form-group">
                    <label for="edit-flight-price">Price (PHP)</label>
                    <input type="number" id="edit-flight-price" placeholder="12,350.50">
                </div>
            </form>

            <div class="options-group">
                <button class="save-button" onclick="saveChangesModal('modal-edit-save')">Save Changes</button>
                <button class="cancel-button" onclick="closeModal('modal-edit')">Cancel</button>
            </div>
        </div>
    </div>

    </main>

<!-- Navbar -->
    <div style="height:300px"></div>
    <script>
        $("#navbar").load("navigation.hbs", function() {
            $("#nav-home").addClass("active");
        });
    </script>
