<link rel="stylesheet" href="CSS\admin.css">

<div class="container" id="create-flights">
<form action="/create-flight" method="POST">
    <div id="flight-details">
        <div class="row g-3">
             
            <div class="col-md-6">
                <label for="flight-number-field">Flight Number:</label>
                <input type="number" name="flightNumber" id="flight-number-field" required>
            </div>
            <div class="col-md-6">
                <label for="airline-field">Airline:</label>
                <input type="text" name="airline" id="airline-field" required>
            </div>
            <div class="col-md-6">
                <label for="origin-field">Origin:</label>
                <input type="text" name="origin" id="origin-field" required>
            </div>
            <div class="col-md-6">
                <label for="destination-field">Destination:</label>
                <input type="text" name="destination" id="destination-field" required>
            </div>
            {{!-- Departure --}}
            <div class="col-md-6">
                <label for="departureDate-field">Departure Date:</label>
                <input type="date" name="departureDate" id="destination-field" placeholder="YYYY-MM-DD" required>
            </div>
            <div class="col-md-6">
                <label for="departureTime-field">Departure Time:</label>
                <input type="time" name="departureTime" id="departureTime-field" placeholder="HH:MM" required>
            </div>

            {{!-- Arrival --}}
            <div class="col-md-6">
                <label for="arrivalDate-field">Arrival Date:</label>
                <input type="date" name="arrivalDate" id="arrivalDate-field"placeholder="YYYY-MM-DD" required>
            </div>
            <div class="col-md-6">
                <label for="arrivalTime-field">Arrival Time:</label>
                <input type="time" name="arrivalTime" id="arrivalTime-field"placeholder="HH:MM" required>
            </div>
            <div class="col-md-6">
                <label for="logoName-field">Logo Name:</label>
                <input type="text" name="logoName" id="logoName-field" required>
            </div>
            <div class="col-md-6 ">
                <label for="numOfLayovers-field">Layovers:</label>
                <input type="text" name="numOfLayovers" id="numOfLayovers-field" required>
            </div>
            <div class="col-md-6">
                <label for="isActive-field">Active:</label>
                <input type="text" name="isActive" id="isActive-field"placeholder="true or false" required>
            </div>

            {{!-- Cabin --}}
            <h2>Cabin Classes</h2>
            <div id="cabin-section">
                <h3>Economy Class</h3>
                    <div class="col-md-4 mt-2">
                        <label for="price-field">Price:</label>
                        <input type="Number" name="cabin[economy][price]" id="price-field" required>
                    </div>
                    <div class="col-md-4 mt-2">
                        <label for="seats-field">Seats:</label>
                        <input type="Number" name="cabin[economy][seats]" id="seats-field" required>
                    </div>
            </div>
            <div id="cabin-section">
                <h3>Premium Economy Class</h3>
                    <div class="col-md-4 mt-2">
                        <label for="price-field">Price:</label>
                        <input type="Number" name="cabin[premium_economy][price]" id="price-field" required>
                    </div>
                    <div class="col-md-4 mt-2">
                        <label for="seats-field">Seats:</label>
                        <input type="Number" name="cabin[premium_economy][seats]" id="seats-field" required>
                    </div>
            </div>
            <div id="cabin-section">
                <h3>Business Class</h3>
                    <div class="col-md-4 mt-2">
                        <label for="price-field">Price:</label>
                        <input type="Number" name="cabin[business_class][price]" id="price-field" required>
                    </div>
                    <div class="col-md-4 mt-2">
                        <label for="seats-field">Seats:</label>
                        <input type="Number" name="cabin[business_class][seats]" id="seats-field" required>
            </div>
            <div id="cabin-section">
                <h3>First Class</h3>
                    <div class="col-md-4 mt-2">
                        <label for="price-field">Price:</label>
                        <input type="Number" name="cabin[first_class][price]" id="price-field" required>
                    </div>
                    <div class="col-md-4 mt-2">
                        <label for="seats-field">Seats:</label>
                        <input type="Number" name="cabin[first_class][seats]" id="seats-field" required>
                    </div>
            </div>
            <div class="row mt-3">
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-secondary" href="create-flight">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </div>


        </div>

    </div>
</form>
</div>