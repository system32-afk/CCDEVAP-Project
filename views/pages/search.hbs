    <link rel="stylesheet" href="/CSS/Search_Styles.css" media="all">
    <link rel="stylesheet" href="/CSS/FlightOptions_Style.css">
    <link rel="stylesheet" href="/scripts/utilities/search_dropdown_style.css">


    <div class="hero-banner">
        <h1>Book Your Flight</h1>
    </div>
    <div id="liveAlertPlaceholder"></div>
    <div id = "search-container">
        <form id = "search-form">

            <div id = "trip-type-toggle">
                <div class="trip-option">   
                    <input type="radio" class = "trip-type" id = "one-way" name="trip-type-group" value="one-way" checked>
                <label class="form-label" for="one-way">One Way</label>
                </div>
                
                <div class="trip-option">
                    <input type="radio" class = "trip-type" id = "round-trip" name="trip-type-group" value="round-trip">
                    <label for="round-trip">Round Trip</label>
                </div>
            </div>

            <div class="row px-5">


                <div class = "col-md-3 input-fields"> 
                    <!-- Origin Input -->
                    <label class="form-label" >Origin</label>
                    

                    <input type="text" class="form-control py-2 city-search" id="origin-city-search" placeholder="Input Origin city" autocomplete="off">

                    <div class="dropdown-list" id="origin-cities"></div>
                </div>


                <div class = "col input-fields">
                    <!-- Destination Input -->
                    <label class="form-label" >Destination</label>
                    

                    <input type="text" class="form-control py-2 city-search" id="destination-city-search" placeholder="Input Destination city" autocomplete="off">

                    <div class="dropdown-list" id="destination-cities"></div>
                </div>

                <div class = " col input-fields">
                    <!-- Date Input -->
                    <label class="form-label" >Departure Date</label>
                    

                    <input type="date" class="form-control py-2" id="departure-date" name="departure-date">

                </div>

                <div class = " col input-fields">
                    <!-- Date Input -->
                    <label class="form-label" >Return Date</label>
                   

                    <input type="date" class="form-control py-2" id="return-date" name="return-date">

                </div>
                
            </div>

            <div class = "row px-3 ps-5 mt-3 justify-content-center">
                <div class = "col-4 input-fields">
                    <label class="form-label">Passengers</label>
                    
                    <button class="btn btn-secondary" type="button" id="passenger-select" data-bs-toggle="dropdown" aria-expanded="false">
                        Select passengers
                    </button>
                    <div class="dropdown-menu" aria-labelledby="passenger-select">
                        <div id = "passenger-dropdown" class="dropdown-passengers">
                            <div class="passenger-row">
                                <!-- Adult -->
                                <label for="adults">Adults</label>
                                <button type = "button" class="btn btn-primary" id="adult-decrease" onclick="subtractPassenger('adults')">-</button>
                                <span id="adults-count">value</span>
                                <button type = "button" class="btn btn-primary" id="adult-increase" onclick="addPassenger('adults')">+</button>
                            </div>

                            <div class="passenger-row">
                                <!-- Children -->
                                <label for="children">Children</label>
                                <button type = "button" class="btn btn-primary" id="child-decrease" onclick="subtractPassenger('children')">-</button>
                                <span id="children-count">value</span>
                                <button type = "button" class="btn btn-primary" id="child-increase" onclick="addPassenger('children')">+</button>
                            </div>

                            <div class="passenger-row">
                                <!-- Infant -->
                                <label for="infants">Infants</label>
                                <button type = "button" class="btn btn-primary" id="infant-decrease" onclick="subtractPassenger('infants')">-</button>
                                <span id="infants-count">value</span>
                                <button type = "button" class="btn btn-primary" id="infant-increase" onclick="addPassenger('infants')">+</button>
                            </div>
                        </div>
                    </div>
                </div>


                <div class = " col-3 input-fields">
                    <label class="form-label">Cabin</label>
                    
                    <button class="btn btn-secondary" type="button" id="cabin-select" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Select Cabin type
                    </button>
                    <div class="dropdown-menu" aria-labelledby="cabin-select">
                        <div id = "cabin-dropdown" class="dropdown-cabin">
                            <div class="cabin-row" data-displayCabinType="Economy" data-cabin ="economy">
                                Economy
                            </div>

                            <div class="cabin-row" data-displayCabinType="Premium Economy" data-cabin ="premium_economy">
                                Premium Economy
                            </div>

                            <div class="cabin-row" data-displayCabinType="Business" data-cabin ="business_class">
                                Business
                            </div>

                            <div class="cabin-row" data-displayCabinType="First class" data-cabin ="first_class">
                                First class
                            </div>
                        </div>
                    </div>

                </div>


                <div class = "col-4 justify-content-between button-fields">
                    
                    <button type="button" class="btn btn-primary" id = "search-flight-button">Search Flights</button>
                    <button type="button" class="btn btn-outline-secondary" id="advance-search-button" data-bs-toggle="collapse" data-bs-target="#Advance-search-panel">
                        Advance Search
                    </button>
                </div>

                
                
            </div>
        </form>
    </div>

    <div class="collapse" id="Advance-search-panel">
        <div class="advance-content">

        <div class="row">

            <div class = "col input-fields airline-preference">
                <button class="btn btn-secondary" type="button" id="airline-select" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Preferred Airline
                    </button>
                    <div class="dropdown-menu" aria-labelledby="airline-select">
                        <div id = "airline-dropdown" class="dropdown-airline">

                            <div class="airline-row" data-airline = "any">
                                Any
                            </div>

                            <div class="airline-row" data-airline = "Philippine Airlines">
                                Philippine Airlines
                            </div>

                            <div class="airline-row" data-airline = "AirAsia">
                                AirAsia
                            </div>

                            <div class="airline-row" data-airline = "Cebu Pacific">
                                Cebu Pacific
                            </div>

                            <div class="airline-row" data-airline = "Cathay Pacific">
                                Cathay Pacific
                            </div>
                        </div>
                    </div>
            </div>


            <div class="col-4 toggle-group">
                <div class = "col input-fields direct-flights-only">
                    <label class="form-check-label">Direct Flights only</label>
                    <input class="form-check-input" type="checkbox" id ="direct-flight-checkbox">
                </div>
            
                <div class = "col input-fields flexible-dates">
                    <div class = "toggle-row">
                        <label class="form-check-label" for="flexSwitchCheckDefault">Flexible Dates</label>

                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id = "flexible-dates-checkbox">
                        </div>



                    </div>
                    <small id="flexible-hint" class="text-muted">Searches flights a week before or after selected date</small>
                </div>
            </div>

            <div class = "input-fields price-filter">
                <label>Price range</label>
                <div class = "range-slider">
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label" for="min-price">Min</label>
                            <input type="number" id="min-price" class="form-control min-price" value="1" min="1">
                        </div>
                        
                        <div class="col-6">
                            <label class="form-label" for="max-price">Max</label>
                            <input type="number" id="max-price" class="form-control max-price" value="10" min="1">
                        </div>
                    </div>

                    <div class="range">
                        <input type="range" class="min-input" value="1" min="1" max = "1000">
                        <input type="range" class="max-input" value="0" min="0" max = "1000">


                        <div class="price-slider">
                            <div class="slider-progress"></div>
                        </div>
                    </div>
                </div>
            </div>


            <div class = "col button-fields">
                    
                    <button type="button" class="btn btn-primary" id = "apply-filter">Apply</button>

            </div>
        </div>
            

        </div>
    </div>

    <!--Flights-->
    
    <div class = "filters">
        <div class="container d-flex align-items-center gap-2">
            <div class="row">
                <p class="mb-0">sort by: </p>
                
            </div>
            <div class="row">
                <div class="dropdown">
                        <a class="btn btn-light dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        </a>

                    <ul class="dropdown-menu p-2">
                        <div class="container-fluid">

                        
                        <div class="sort-option d-flex align-items-center gap-2 mb-2">
                            <input type="radio" class="sort" name="sort-group" id="sort-departure" value="departure">
                            <label for="sort-departure">Departure: Earliest first</label>
                        </div>


                        <div class="sort-option d-flex align-items-center gap-2 mb-2">
                            <input type="radio" class="sort" name="sort-group" id="sort-flight-duration" value="duration">
                            <label for="sort-flight-duration">Flight Duration: shortest first</label>
                        </div>

                        <div class="sort-option d-flex align-items-center gap-2 mb-2">
                            <input type="radio" class="sort" name="sort-group" id="sort-price" value="ticketPrice">
                            <label for="sort-price">Price: Lowest first</label>
                        </div>
                        </div>
                    </ul>

                    <button type="button" class="btn btn-outline-primary" id = "open-filter-sidebar-btn" data-bs-toggle="offcanvas" data-bs-target="#filter-sidebar" aria-controls="offcanvasWithBackdrop">Filter Options</button>
                </div>


        
            </div>
        </div>

    </div>
        
        <div class="container d-flex align-items-left">
            <h1 id = "prompt-message">Pick your departure flight</h1>
        </div>
        
        <div class="container flight-option-container">
            
        </div>

        <!--Flights additional Information-->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
            <div class="offcanvas-header">
                <h5 id="offcanvasRightLabel">Flight Details</h5>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
                <div class="offcanvas-body">
            </div>
        </div>



        <div class="offcanvas offcanvas-start" tabindex="-1" id="filter-sidebar" aria-labelledby="offcanvasWithBackdropLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasWithBackdropLabel">Filter Options</h5>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                
                <!--AIRLINE FILTER-->
                <div class="text-start">
                    <h4>filter by airline</h4>
                </div>

                <div class="airlines">
                    <button type="button" class="btn btn-outline-primary w-100 mb-3" id="select-all-airlines-btn">All airlines</button>
                        <div class="airlines-filter-group">
                            <div class="form-check mb-2">
                                <input class="form-check-input airline-filter" type="checkbox" value="Philippine Airlines" id="filter-PAL" checked>
                                <label class="form-check-label" for="filter-PAL">
                                    Philippine Airlines
                                </label>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input airline-filter" type="checkbox" value="AirAsia" id="filter-AirAsia"checked>
                                <label class="form-check-label" for="filter-AirAsia">
                                    AirAsia
                                </label>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input airline-filter" type="checkbox" value="Cebu Pacific" id="filter-CebPac"checked>
                                <label class="form-check-label" for="filter-CebPac">
                                    Cebu Pacific
                                </label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input airline-filter" type="checkbox" value="Cathay Pacific" id="filter-CathPac"checked>
                                <label class="form-check-label" for="filter-CathPac">
                                    Cathay Pacific
                                </label>
                            </div>

                        </div>

                </div>


                    <hr>


                <!--PRICE FILTER-->
                <div class="text-start mt-3">
                    <h4>filter by price</h4>
                </div>

                <div class="price-filter">
                    <label for="customRange3" class="form-label">Max price range</label>
                    <span id="price-limit-label" class="fw-bold text-primary">PHP 0</span>
                    <input type="range" class="form-range" min="500" value="500" max="1000" step="1" id="sidebar-price-range">
                    <div class="rounded">
                        <span id="current-price" class="fw-bold text-primary">PHP 500</span>
                    </div>

                </div>


                <hr>

                <!--DEPARTURE FILTER-->
                <div class="text-start">
                    <h4>filter by departure schedules</h4>
                </div>

                <div class="departure">
                    <button type="button" class="btn btn-outline-primary w-100 mb-3" id="reset-departure-filter">Reset</button>
                        <div class="departure-filter-group">
                            <div class="form-check mb-2">
                                <input class="form-check-input departure-filter" type="checkbox" value="morning" id="filter-dep-morning"checked>
                                <label class="form-check-label" for="filter-dep-morning">
                                   Morning: 6:00 - 12:00
                                </label>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input departure-filter" type="checkbox" value="afternoon" id="filter-dep-afternoon"checked>
                                <label class="form-check-label" for="filter-dep-afternoon">
                                    Afternoon: 12:00  - 18:00 
                                </label>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input departure-filter" type="checkbox" value="evening" id="filter-dep-evening"checked>
                                <label class="form-check-label" for="filter-dep-evening">
                                    Evening: 18:00 - 0:00 
                                </label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input departure-filter" type="checkbox" value="night" id="filter-dep-night" checked>
                                <label class="form-check-label" for="filter-dep-night">
                                    Night: 00:00 AM - 6:00
                                </label>
                            </div>

                        </div>

                </div>


                <hr>
                <!--DEPARTURE FILTER-->
                <div class="text-start">
                    <h4 class="fw-bold">filter by stops</h4>
                </div>

                <div class="stops">

                    
                        <label class="form-label fw-semibold">Stops</label>
                        
                        <div class="form-check mb-2">
                            <input class="form-check-input stop-filter" type="radio" value="any" name="stop-group" id="stop-any" checked>
                            <label class="form-check-label" for="stop-any">Any</label>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input stop-filter" type="radio" value="0" name="stop-group" id="stop-0">
                            <label class="form-check-label" for="stop-0">Non-stop</label>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input stop-filter" type="radio" name="stop-group" value="1" id="stop-1">
                            <label class="form-check-label" for="stop-1">1 Stop</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input stop-filter" type="radio" name="stop-group"value="2" id="stop-2">
                            <label class="form-check-label" for="stop-2">2+ Stops</label>
                        </div>
                </div>


                <button type="button" class="btn btn-primary w-100 mb-3" id="apply-all-filter">Apply filters</button>
                <button type="button" class="btn btn-outline-danger w-100 mb-3" id="reset-all-filter">Reset all filters</button>
            </div>
        </div>